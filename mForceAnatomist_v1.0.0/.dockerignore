# 2026.09.15: there was no .dockerignore, so every build shipped .git, the archive
# directories and any local node_modules into the build context before the first
# instruction ran. Small here (2.6M) but free to fix, and it keeps the context from
# growing back.
.git
.gitignore
node_modules
dist
.angular
_archive
_to_delete
_setup
**/*.bak_*
**/.DS_Store
Dockerfile*
.dockerignore
